{
  "name": "KFC Football Club App",
  "short_name": "KFC Football",
  "description": "KFC Football Club의 일정, 참가 신청, 출석과 공지를 관리하는 회원 전용 웹 앱",
  "id": "./",
  "start_url": "./#home",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f4f1e7",
  "theme_color": "#12372a",
  "lang": "ko-KR",
  "orientation": "portrait-primary",
  "icons": [
    {
      "src": "./icons/kfc-app-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/kfc-app-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/kfc-app-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "일정 확인",
      "short_name": "일정",
      "url": "./#schedule"
    },
    {
      "name": "공지사항",
      "short_name": "공지",
      "url": "./#announcements"
    }
  ]
}
